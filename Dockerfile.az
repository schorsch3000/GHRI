FROM debian:13

# Debian backports as an extra apt source
RUN printf '%s\n' \
    "Types: deb deb-src" \
    "URIs: http://deb.debian.org/debian" \
    "Suites: trixie-backports" \
    "Components: main" \
    "Enabled: yes" \
    "Signed-By: /usr/share/keyrings/debian-archive-keyring.gpg" \
    > /etc/apt/sources.list.d/debian-backports.sources

# Everything listed in apt-packages.txt (ghri runtime, dev tooling, extras)
COPY apt-packages.txt /tmp/apt-packages.txt
RUN apt update && apt -y upgrade \
    && grep -vE '^(#|$)' /tmp/apt-packages.txt | xargs apt -y install \
    && rm /tmp/apt-packages.txt
